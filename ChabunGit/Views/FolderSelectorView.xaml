<!-- File: ChabunGit/Views/FolderSelectorView.xaml -->
<Window x:Class="ChabunGit.Views.FolderSelectorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChabunGit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FolderSelectorViewModel}"
        Title="{Binding Title}"
        Height="600" Width="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- 설명 텍스트 -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Foreground="#555"/>

        <!-- 빠른 선택 버튼 -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <Button Content="⚠️ 대용량만 자동 선택"
                    Command="{Binding SelectLargeOnlyCommand}"
                    Padding="8,4"
                    Margin="0,0,6,0"
                    Background="#FF8C00"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>
            <Button Content="전체 선택"
                    Command="{Binding SelectAllCommand}"
                    Padding="8,4"
                    Margin="0,0,6,0"/>
            <Button Content="전체 해제"
                    Command="{Binding DeselectAllCommand}"
                    Padding="8,4"/>
        </StackPanel>

        <!-- 하단 버튼 -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="Gray"
                       FontSize="11"
                       Text="선택하지 않으면 AI가 알아서 판단합니다."/>
            <Button Content="선택 없이 건너뜀"
                    Command="{Binding SkipCommand}"
                    Padding="10,5"
                    Margin="0,0,6,0"/>
            <Button Content="✅ 선택 완료 후 AI 생성"
                    Command="{Binding ConfirmCommand}"
                    Padding="10,5"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>

        <!-- 파일 트리 -->
        <Border BorderBrush="#CCC"
                BorderThickness="1"
                CornerRadius="4">
            <TreeView ItemsSource="{Binding TreeItems}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                            <!-- 대용량 항목은 주황색으로 강조 -->
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding DisplayText}"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLarge}" Value="True">
                                                <Setter Property="Foreground" Value="#CC4400"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </DockPanel>
</Window>
