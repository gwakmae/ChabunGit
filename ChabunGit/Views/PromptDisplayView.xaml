<!-- File: ChabunGit/Views/PromptDisplayView.xaml -->
<Window x:Class="ChabunGit.Views.PromptDisplayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChabunGit.ViewModels"
        xmlns:local="clr-namespace:ChabunGit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PromptDisplayViewModel}"
        Title="{Binding Title}" Height="600" Width="750"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <!-- ▼▼▼ [추가] 리소스를 창 자체에도 선언하여 App.xaml 참조 실패를 방지 ▼▼▼ -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
    </Window.Resources>
    <!-- ▲▲▲ [추가] 여기까지 ▲▲▲ -->

    <DockPanel Margin="10">

        <!-- 하단 버튼 영역 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">

            <!-- ▼▼▼ 파싱 실패 시 수동 입력 영역 ▼▼▼ -->
            <Border Visibility="{Binding IsManualInputVisible,
                                 Converter={StaticResource BooleanToVisibilityConverter},
                                 FallbackValue=Collapsed}"
                    BorderBrush="Orange"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <!-- 경고 메시지 -->
                    <TextBlock Text="{Binding ParseWarningText}"
                               Foreground="OrangeRed"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <!-- 제목 입력 -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="제목:"
                                   VerticalAlignment="Center"
                                   Width="40"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ManualTitle.Length,
                                          StringFormat={}{0}/50자}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Margin="5,0,0,0"/>
                        <TextBox Text="{Binding ManualTitle, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="50"/>
                    </DockPanel>

                    <!-- 본문 입력 -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="본문:"
                                   VerticalAlignment="Top"
                                   Width="40"
                                   Margin="0,4,0,0"/>
                        <TextBox Text="{Binding ManualBody, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>

                    <!-- 수동 적용 버튼 -->
                    <Button Content="✅ 직접 입력한 내용으로 커밋 창에 적용"
                            Command="{Binding ApplyManualInputCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Padding="10,5"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>
            <!-- ▲▲▲ 수동 입력 영역 끝 ▲▲▲ -->

            <!-- 파싱 경고 텍스트 (파싱은 됐지만 형식이 약간 달랐던 경우) -->
            <TextBlock Text="{Binding ParseWarningText}"
                       Foreground="OrangeRed"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsManualInputVisible,
                                    Converter={StaticResource BooleanInverterConverter}}"/>

            <!-- 일반 버튼 행 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- AI 프롬프트 생성 버튼 -->
                <Button Content="✨ AI 프롬프트 생성"
                        Command="{Binding GenerateAiPromptCommand}"
                        Visibility="{Binding IsGenerateButtonVisible,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,5,0"/>

                <!-- 자동 파싱 성공 시 적용 버튼 -->
                <Button Content="{Binding ApplyButtonText}"
                        Command="{Binding ApplyToCommitCommand}"
                        Visibility="{Binding IsApplyButtonVisible,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Padding="10,5"
                        Margin="0,0,5,0"/>

                <!-- 복사 버튼 -->
                <Button Content="{Binding CopyButtonText}"
                        Command="{Binding CopyToClipboardCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- AI 응답 전체 텍스트 표시 -->
        <TextBox Text="{Binding PromptText}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>
    </DockPanel>
</Window>
